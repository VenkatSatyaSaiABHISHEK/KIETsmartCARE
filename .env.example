# ==============================================================================
# KIET Smart Care - Environment Variables Configuration
# Copy this file to .env.local (in apps/web) or .env (in apps/student)
# ==============================================================================

# --- SUPABASE CORE (PostgreSQL, Auth, Storage, Edge Functions) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-never-expose-to-client
SUPABASE_JWT_SECRET=your-jwt-secret

# --- WEB APP (Next.js 15 App Router) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_SUBDOMAIN=admin.localhost:3000

# --- STUDENT EXPO APP (React Native) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- STORAGE BUCKETS (Private Buckets Only - Signed Short-Lived URLs) ---
SUPABASE_STORAGE_BUCKET_PRESCRIPTIONS=prescriptions
SUPABASE_STORAGE_BUCKET_MEDICAL=medical-records
SUPABASE_STORAGE_BUCKET_AUDIT=audit-exports

# --- PUSH NOTIFICATIONS & EDGE FUNCTIONS ---
EXPO_ACCESS_TOKEN=your-expo-access-token-if-configured

# --- INSTITUTIONAL CLINIC CONTACT ---
NEXT_PUBLIC_CAMPUS_HEALTH_PHONE=+91-120-2983555
